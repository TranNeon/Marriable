import React from 'react';
import { MoreVertical, FileText, FileBadge, FileIcon } from 'lucide-react';

// Sample data structure matching the UI
const projects = [
  { id: 1, title: 'DN01_CHUONG TRINH T...', date: 'Opened 2:09 PM', type: 'word' },
  { id: 2, title: 'aws cognito + api gateway', date: 'May 7, 2026', type: 'doc' },
  { id: 3, title: 'mein_cheatsheet_andriod', date: 'May 7, 2026', type: 'doc' },
  { id: 4, title: 'PRAGMATA Deluxe Editio...', date: 'Apr 20, 2026', type: 'doc' },
  { id: 5, title: 'Untitled document', date: 'Opened Apr 19, 2026', type: 'doc' },
];

const getFileIcon = (type) => {
  switch (type) {
    case 'word':
      return <FileBadge className="w-4 h-4 text-blue-600" />;
    case 'doc':
    default:
      return <FileText className="w-4 h-4 text-blue-400" />;
  }
};

export default function ProjectGrid() {
  return (
    <div className="p-6 max-w-7xl mx-auto">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <h2 className="text-lg font-medium text-gray-800">Recent documents</h2>
        <div className="flex items-center gap-4 text-sm text-gray-600 cursor-pointer">
          <span>Owned by anyone</span>
          <span className="text-xs">▼</span>
        </div>
      </div>

      {/* Grid Layout */}
      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
        {projects.map((project) => (
          <div
            key={project.id}
            className="group flex flex-col border border-gray-200 rounded-md bg-white hover:border-blue-400 cursor-pointer transition-colors"
          >
            {/* Document Preview Thumbnail */}
            <div className="h-64 bg-gray-50 border-b border-gray-200 flex justify-center p-4 overflow-hidden rounded-t-md">
              <div className="w-full h-full bg-white shadow-sm border border-gray-100 p-2 text-gray-300 text-xs">
                {/* Placeholder for actual document preview image */}
                [Document Preview]
              </div>
            </div>

            {/* Document Metadata Footer */}
            <div className="p-3">
              <h3 className="text-sm font-medium text-gray-800 truncate mb-2">
                {project.title}
              </h3>

              <div className="flex items-center justify-between text-gray-500">
                <div className="flex items-center gap-2">
                  {getFileIcon(project.type)}
                  {/* Mock Avatar for shared users */}
                  <div className="flex -space-x-1">
                    <div className="w-5 h-5 rounded-full bg-gray-300 border border-white"></div>
                    <div className="w-5 h-5 rounded-full bg-gray-400 border border-white"></div>
                  </div>
                  <span className="text-xs">{project.date}</span>
                </div>

                <button className="p-1 hover:bg-gray-100 rounded-full opacity-0 group-hover:opacity-100 transition-opacity">
                  <MoreVertical className="w-4 h-4 text-gray-600" />
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
